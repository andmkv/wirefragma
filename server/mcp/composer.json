{
    "name": "wirefragma/mcp",
    "description": "Remote MCP endpoint for Wirefragma accounts (Streamable HTTP, plain PHP on shared hosting).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "mcp/sdk": "^0.8.1",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "opis/json-schema": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Wirefragma\\Mcp\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
