{
  "name": "wirefragma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visual wireframe editor that exports LLM-readable UI specifications",
  "scripts": {
    "dev": "vite",
    "dev:api": "php -S 127.0.0.1:8787 -t server",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
